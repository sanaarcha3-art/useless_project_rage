{
  "name": "ragedesk",
  "version": "0.1.0",
  "description": "Destroy your desktop without actually destroying your desktop.",
  "main": "dist-electron/main.js",
  "author": "RageDesk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "node scripts/dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "electron:portable": "npm run build && electron-builder --win portable",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/howler": "^2.2.11",
    "@types/node": "^20.14.0",
    "electron": "30.5.1",
    "electron-builder": "^25.1.8",
    "howler": "^2.2.4",
    "pixi.js": "^8.5.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.ragedesk.app",
    "productName": "RageDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist//*",
      "dist-electron//*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}